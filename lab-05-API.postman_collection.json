    {
      "name": "registrations",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful POST request\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has result OK\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.result).to.eql(\"OK\");",
              "});",
              "",
              "pm.test(\"Response contains registration ID\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"registrationID\");",
              "    pm.expect(jsonData.registrationID).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentID\": \"s1\",\n  \"courseID\": \"cs101\"\n}",
          "options": {
